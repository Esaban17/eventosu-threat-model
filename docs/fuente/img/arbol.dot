digraph G {
rankdir=LR; nodesep=0.12; ranksep=0.35;
graph [fontname="Inter", bgcolor="white"]; node [fontname="Inter", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"]; edge [color="#777777", arrowhead=none];
"R" [label="Entrar a un evento sin pagar\n[O]", fillcolor="#c0392b", fontcolor="white", color="#7b1f16", penwidth=2, fontsize=12];
"1" [label="1. Falsificar la confirmación de pago\n[O]", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"1.1" [label="1.1 Webhook forjado\n[Y]\nQ0 · habilidad baja (curl) · AM-01", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"1.1.a" [label="Descubrir la URL del webhook\n(documentación del proveedor / DevTools)\nQ0 · minutos", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"1.1.b" [label="La API no verifica la firma HMAC\n(condición de diseño)\n—", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"1.1.c" [label="Enviar POST {estado: aprobado} con curl\nQ0 · minutos", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"1.2" [label="1.2 Pagar menos de lo debido\n[Y]\nQ1 · habilidad media (proxy) · AM-09", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"1.2.a" [label="Interceptar la redirección a la pasarela\n(Burp Suite Community)\nQ0", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"1.2.b" [label="Cambiar monto=350 por monto=1 y pagar Q1\nQ1", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"1.2.c" [label="La API no compara el monto del webhook\n(condición de diseño)\n—", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"2" [label="2. Obtener un QR válido ajeno o falso\n[O]", fillcolor="#fde2e2", color="#c0392b", penwidth=2.4, shape=box];
"2.1" [label="2.1 Fabricar QR con ID secuencial\n[Y]\nQ25 una sola vez · sin habilidad técnica · AM-02", fillcolor="#fde2e2", color="#c0392b", penwidth=2.4, shape=box];
"2.1.a" [label="Comprar UNA entrada barata y leer su QR\n(“INS-1042”)\n≈Q25", fillcolor="#fde2e2", color="#c0392b", penwidth=2.4, shape=box];
"2.1.b" [label="Generar INS-1043… con un generador de QR gratuito\nQ0", fillcolor="#fde2e2", color="#c0392b", penwidth=2.4, shape=box];
"2.1.c" [label="Presentarse antes que el dueño legítimo\nQ0", fillcolor="#fde2e2", color="#c0392b", penwidth=2.4, shape=box];
"2.2" [label="2.2 Usar el QR de otra persona\n[O]", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"2.2.a" [label="Captura de pantalla compartida / reventa\n(riesgo aceptado AM-07)\nQ0 · depende de un tercero", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"2.2.b" [label="Carrera en dos puertas a la vez\n[Y]\nQ0 · coordinación · AM-08", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"2.2.b1" [label="Copia del QR de un cómplice que sí pagó\nQ0", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"2.2.b2" [label="Escanear en el mismo segundo en otra puerta\n(SELECT luego UPDATE no atómico)\nQ0", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3" [label="3. Burlar el control en la puerta\n[O]", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"3.1" [label="3.1 Escalar privilegios en la API\n[O]", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"3.1.a" [label="PATCH /usuarios/:id/rol sin control de rol\n(/admin solo oculto en React)\nQ0 · habilidad media · AM-22", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3.1.b" [label="Forjar JWT (alg none / llave débil)\nQ0 · habilidad alta · AM-23", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3.1.c" [label="Llamar /qr/validar con cuenta de estudiante\n(sin rol Puerta)\nQ0 · habilidad media · AM-24", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3.2" [label="3.2 Dejar la puerta sin validación\n[Y]\nAlquiler de botnet · motivación alta · AM-19", fillcolor="#eef2f7", color="#555555", penwidth=1, shape=box];
"3.2.a" [label="Saturar /qr/validar el día del evento\n≈Q400 (botnet por horas)", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3.2.b" [label="El personal deja pasar sin validar\n(no hay modo offline)\n—", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"3.3" [label="3.3 Personal de puerta cómplice\n(cuenta compartida, sin atribución AM-13)\nSoborno", fillcolor="#ffffff", color="#555555", penwidth=1, shape=box];
"R" -> "1" [color="#777777", penwidth=1];
"1" -> "1.1" [color="#777777", penwidth=1];
"1.1" -> "1.1.a" [color="#777777", penwidth=2.4];
"1.1" -> "1.1.b" [color="#777777", penwidth=2.4];
"1.1" -> "1.1.c" [color="#777777", penwidth=2.4];
"1" -> "1.2" [color="#777777", penwidth=1];
"1.2" -> "1.2.a" [color="#777777", penwidth=2.4];
"1.2" -> "1.2.b" [color="#777777", penwidth=2.4];
"1.2" -> "1.2.c" [color="#777777", penwidth=2.4];
"R" -> "2" [color="#c0392b", penwidth=2.6];
"2" -> "2.1" [color="#c0392b", penwidth=2.6];
"2.1" -> "2.1.a" [color="#c0392b", penwidth=2.6];
"2.1" -> "2.1.b" [color="#c0392b", penwidth=2.6];
"2.1" -> "2.1.c" [color="#c0392b", penwidth=2.6];
"2" -> "2.2" [color="#777777", penwidth=1];
"2.2" -> "2.2.a" [color="#777777", penwidth=1];
"2.2" -> "2.2.b" [color="#777777", penwidth=1];
"2.2.b" -> "2.2.b1" [color="#777777", penwidth=2.4];
"2.2.b" -> "2.2.b2" [color="#777777", penwidth=2.4];
"R" -> "3" [color="#777777", penwidth=1];
"3" -> "3.1" [color="#777777", penwidth=1];
"3.1" -> "3.1.a" [color="#777777", penwidth=1];
"3.1" -> "3.1.b" [color="#777777", penwidth=1];
"3.1" -> "3.1.c" [color="#777777", penwidth=1];
"3" -> "3.2" [color="#777777", penwidth=1];
"3.2" -> "3.2.a" [color="#777777", penwidth=2.4];
"3.2" -> "3.2.b" [color="#777777", penwidth=2.4];
"3" -> "3.3" [color="#777777", penwidth=1];
legend [shape=plaintext, fillcolor="white", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#eef2f7">[O] cualquiera de los hijos basta</td></tr><tr><td bgcolor="#eef2f7">[Y] se necesitan todos los hijos (arco grueso)</td></tr><tr><td bgcolor="#fde2e2"><font color="#c0392b"><b>Camino más barato para el atacante</b></font></td></tr></table>>];
}